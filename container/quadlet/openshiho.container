# Sample Quadlet for running OpenShiho under podman + systemd.
# Copy to ~/.config/containers/systemd/openshiho.container
# then: systemctl --user daemon-reload
#        systemctl --user enable --now openshiho.service

[Unit]
Description=OpenShiho (Debian 12 KDE Plasma agentic CTF runtime)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/openshiho:latest
ContainerName=openshiho
Network=bridge
PublishPort=5901:5901
PublishPort=2222:2222
Memory=2g
HostName=openshiho
AddHost=openshiho:127.0.0.1
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN NET_RAW
SecurityLabelDisable=true
Exec=/sbin/init

[Install]
WantedBy=default.target
